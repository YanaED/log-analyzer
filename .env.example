# Скопируйте этот файл в .env и заполните значения.
# Файл .env не коммитится в Git.

# Секрет сессий Flask (задайте свой случайный ключ)
APP_SECRET_KEY=change-this-secret-key-in-production

# E-mail администратора (доступ к вкладке «Аудит»)
ADMIN_EMAIL=admin@example.com

# Хост и порт приложения
APP_HOST=127.0.0.1
APP_PORT=8050
# Для доступа с других устройств в сети: APP_HOST=0.0.0.0
# PUBLIC_APP_URL=http://192.168.1.100:8050

# MongoDB (по умолчанию localhost:27017)
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_DB_NAME=log_analysis_dashboard

# SMTP для подтверждения e-mail при регистрации (опционально)
# Если SMTP не задан, аккаунты активируются сразу без письма.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
